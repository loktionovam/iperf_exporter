        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "iperf_exporter_udp_bandwidth{connection_pair=~\"$connection_pair\"}",
          "legendFormat": "{{connection_pair}} / {{peer_port}}",
          "refId": "A"
        }
      ],
