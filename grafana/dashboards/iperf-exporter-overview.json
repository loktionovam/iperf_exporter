  "refresh": "30s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": [
    "iperf",
    "network",
    "prometheus"
  ],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "query_result(count by (connection_pair) (iperf_exporter_udp_transfer{connection_pair!=\"\"} or iperf_exporter_tcp_transfer{connection_pair!=\"\"}))",
        "hide": 0,
        "includeAll": true,
        "label": "Client->Server Pair",
        "multi": false,
        "name": "connection_pair",
        "options": [],
        "query": "query_result(count by (connection_pair) (iperf_exporter_udp_transfer{connection_pair!=\"\"} or iperf_exporter_tcp_transfer{connection_pair!=\"\"}))",
        "refresh": 2,
        "regex": "/connection_pair=\"([^\"]+)\"/",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-15m",
    "to": "now"
