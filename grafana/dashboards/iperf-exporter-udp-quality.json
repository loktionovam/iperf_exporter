  "description": "UDP jitter, loss, latency and packet-rate metrics exported by iperf_exporter. The dashboard is split into collapsible sections so you can hide context, latency or rate panels independently.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 101,
      "panels": [],
      "title": "Measurement Context",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "One key/value table that explains under what conditions the selected UDP pair/session was measured. When Client->Server Pair is set to All, use the Session variable to narrow the table to one client port.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 11,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": false,
            "displayName": "Parameter"
          }
        ]
      },
      "targets": [
        {
          "expr": "max by (connection_pair, peer_port, parameter, setting_value) (label_replace(label_replace(iperf_exporter_udp_test_info{connection_pair=~\"$connection_pair\", peer_port=~\"$session_port\"}, \"parameter\", \"Server Port\", \"__name__\", \".*\"), \"setting_value\", \"$1\", \"local_port\", \"(.*)\")) or max by (connection_pair, peer_port, parameter, setting_value) (label_replace(label_replace(iperf_exporter_udp_test_info{connection_pair=~\"$connection_pair\", peer_port=~\"$session_port\"}, \"parameter\", \"Peer Version\", \"__name__\", \".*\"), \"setting_value\", \"$1\", \"peer_version\", \"(.*)\")) or max by (connection_pair, peer_port, parameter, setting_value) (label_replace(label_replace(iperf_exporter_udp_test_info{connection_pair=~\"$connection_pair\", peer_port=~\"$session_port\"}, \"parameter\", \"Trip-Times Enabled\", \"__name__\", \".*\"), \"setting_value\", \"$1\", \"trip_times_enabled\", \"(.*)\")) or max by (connection_pair, peer_port, parameter, setting_value) (label_replace(label_replace(iperf_exporter_udp_test_info{connection_pair=~\"$connection_pair\", peer_port=~\"$session_port\"}, \"parameter\", \"Report Interval (s)\", \"__name__\", \".*\"), \"setting_value\", \"$1\", \"report_interval_seconds\", \"(.*)\")) or max by (connection_pair, peer_port, parameter, setting_value) (label_replace(label_replace(iperf_exporter_udp_test_info{connection_pair=~\"$connection_pair\", peer_port=~\"$session_port\", client_bandwidth_limit!=\"\"}, \"parameter\", \"Client Bandwidth Limit\", \"__name__\", \".*\"), \"setting_value\", \"$1\", \"client_bandwidth_limit\", \"(.*)\")) or max by (connection_pair, peer_port, parameter, setting_value) (label_replace(label_replace(iperf_exporter_udp_test_info{connection_pair=~\"$connection_pair\", peer_port=~\"$session_port\", client_additional_params!=\"\"}, \"parameter\", \"Client Extra Params\", \"__name__\", \".*\"), \"setting_value\", \"$1\", \"client_additional_params\", \"(.*)\")) or max by (connection_pair, peer_port, parameter, setting_value) (label_replace(label_replace(iperf_exporter_udp_test_info{connection_pair=~\"$connection_pair\", peer_port=~\"$session_port\"}, \"parameter\", \"Datagram Size (B)\", \"__name__\", \".*\"), \"setting_value\", \"$1\", \"server_len_bytes\", \"(.*)\")) or max by (connection_pair, peer_port, parameter, setting_value) (label_replace(label_replace(iperf_exporter_udp_test_info{connection_pair=~\"$connection_pair\", peer_port=~\"$session_port\", server_udp_buffer_bytes!=\"\"}, \"parameter\", \"UDP Buffer (B)\", \"__name__\", \".*\"), \"setting_value\", \"$1\", \"server_udp_buffer_bytes\", \"(.*)\")) or max by (connection_pair, peer_port, parameter, setting_value) (label_replace(label_replace(iperf_exporter_udp_test_info{connection_pair=~\"$connection_pair\", peer_port=~\"$session_port\", server_additional_params!=\"\"}, \"parameter\", \"Server Extra Params\", \"__name__\", \".*\"), \"setting_value\", \"$1\", \"server_additional_params\", \"(.*)\"))",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "title": "UDP Measurement Context",
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            },
            "indexByName": {
              "connection_pair": 0,
              "peer_port": 1,
              "parameter": 2,
              "setting_value": 3
            },
            "renameByName": {
              "connection_pair": "Client->Server Pair",
              "peer_port": "Client Port",
              "parameter": "Parameter",
              "setting_value": "Value"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Hop-by-hop route observed by `tracepath` from the exporter/server namespace toward the peer/client address for the selected pair/session. When Client->Server Pair is set to All, use the Session variable to narrow the table to one client port.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "id": 120,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": false,
            "displayName": "Hop"
          }
        ]
      },
      "targets": [
        {
          "expr": "max by (connection_pair, peer_port, hop_index, hop_address, hop_summary) (iperf_exporter_udp_path_trace_hop_info{connection_pair=~\"$connection_pair\", peer_port=~\"$session_port\", trace_direction=\"server_to_client\"})",
          "format": "time_series",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "title": "UDP Path Trace",
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            },
            "indexByName": {
              "connection_pair": 0,
              "peer_port": 1,
              "hop_index": 2,
              "hop_address": 3,
              "hop_summary": 4
            },
            "renameByName": {
              "connection_pair": "Client->Server Pair",
              "peer_port": "Client Port",
              "hop_address": "Hop Address",
              "hop_index": "Hop",
              "hop_summary": "Details"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Inter-arrival jitter reported by iperf for the selected UDP stream. Unit: milliseconds.",
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 11
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "iperf_exporter_udp_jitter{connection_pair=~\"$connection_pair\", peer_port=~\"$session_port\"}",
          "legendFormat": "{{connection_pair}} / {{peer_port}}",
          "refId": "A"
        }
      ],
      "title": "UDP Jitter",
      "type": "timeseries"
