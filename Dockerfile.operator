FROM python:3.14-alpine@sha256:c6ead215bfd31f1e433d968853b7a769989117115b728874824e6c0a27cb96fc

# Apply security fixes even when the pinned Python image has not been rebuilt.
RUN apk upgrade --no-cache \
    && adduser -H -S -D -u 1000 iperf_operator

WORKDIR /app

COPY requirements-operator.txt ./

# hadolint ignore=DL3013
RUN python -m pip install --no-cache-dir -r requirements-operator.txt \
    && python -m pip uninstall --yes pip setuptools

COPY iperf_operator ./iperf_operator

ARG VERSION=v4.0.0

USER iperf_operator

LABEL maintainer=loktionovam@gmail.com
LABEL version=${VERSION}

ENV IPERF_OPERATOR_DEFAULT_EXPORTER_IMAGE=ghcr.io/loktionovam/iperf_exporter_server:${VERSION} \
    IPERF_OPERATOR_VERSION=${VERSION} \
    PYTHONPATH=/app \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

EXPOSE 9869

ENTRYPOINT ["kopf", "run", "--standalone", "-m", "iperf_operator.controller"]
